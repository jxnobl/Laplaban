{
  "expo": {
    "name": "Laplaban",
    "slug": "Laplaban",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/logo.png"
    },
    "android": {
      "package": "com.laplaban.app",
      "adaptiveIcon": {
        "backgroundColor": "#07080C",
        "foregroundImage": "./assets/logo.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Laplaban to access your device location to trace GPS routes and find nearby fitness partners."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7073bd5-0463-4598-9064-48242f5ab6ff"
      }
    }
  }
}